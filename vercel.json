{
    "rewrites": [
        {
            "source": "/work",
            "destination": "/work/index.html"
        },
        {
            "source": "/contact",
            "destination": "/contact/index.html"
        },
        {
            "source": "/graphics",
            "destination": "/graphics/index.html"
        },
        {
            "source": "/work/:projectId",
            "destination": "/work/:projectId/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
